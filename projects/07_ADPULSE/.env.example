# Copy to .env. Keep credentials on the server; never paste them into browser code.
PORT=3070


# Meta: token with ads_read access to the selected advertising account.
META_ACCESS_TOKEN=
META_API_VERSION=v26.0
# Select ONE non-overlapping action matching your measurement objective.
META_CONVERSION_ACTION=offsite_conversion.fb_pixel_purchase

# Google Ads: approved developer token and OAuth refresh token with adwords scope.
GOOGLE_DEVELOPER_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_API_VERSION=v25
# Optional manager customer ID (without hyphens).
GOOGLE_LOGIN_CUSTOMER_ID=

# TikTok: approved reporting access token.
TIKTOK_ACCESS_TOKEN=
# Set the actual advertiser account currency, e.g. ILS, USD, EUR.
TIKTOK_ACCOUNT_CURRENCY=
# Pick supported conversion and monetary value metrics for your campaign objective.
# Confirm these names in TikTok's Basic Report documentation for your account.
TIKTOK_CONVERSION_METRIC=
TIKTOK_REVENUE_METRIC=
