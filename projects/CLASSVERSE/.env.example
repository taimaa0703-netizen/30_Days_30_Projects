# Copy to .env for local development: Copy-Item .env.example .env
# Run with:  node --env-file=.env server.js
# Never commit .env. On a hosting provider, set these in its dashboard instead.

# Port the server listens on (hosting providers usually set this for you).
PORT=3000

# Set to "true" when running behind a reverse proxy / load balancer (Render, Railway, Fly.io, Nginx).
TRUST_PROXY=false

# Hours a classroom is kept in memory after its last activity.
ROOM_TTL_HOURS=6

# Only needed if the frontend is served from a different origin than this server.
# Comma-separated list, for example: https://classverse.example.com
ALLOWED_ORIGINS=

# --- Teacher accounts (Clerk) ---------------------------------------------
# Clerk dashboard -> API Keys. Enable "Email" and "Google" under User & Authentication.
# The publishable key is public by design; the secret key stays on the server only.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Persistent storage (Neon PostgreSQL) ---------------------------------
# Neon console -> Connection Details -> copy the connection string (sslmode=require).
# Tables are created automatically on first start.
DATABASE_URL=

# Local development ONLY: let teachers host without signing in when Clerk is not configured.
# Never enable in production.
ALLOW_ANONYMOUS_TEACHER=false
